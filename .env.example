# ホスト側に公開するポート（コンテナ内はいずれも 8080）
API_HOST_PORT=8080
LOGIN_HOST_PORT=8081
# ローカル確認用 APIキー（make keys-add で発行した値を .env にだけ保存する。Git に含めない）
LOCAL_API_KEY=
# ログイン画面（/login）に入れる Google アカウント（カンマ区切り）
ALLOWED_EMAILS=ise0615@gmail.com
# 1 のとき Google の代わりに内蔵のフェイク OAuth を使う（ローカル専用。Cloud Run では起動を拒否する）
OAUTH_FAKE=1
# 実際の Google OAuth を試すとき（OAUTH_FAKE を空にする）: {"client_id":"...","client_secret":"..."} を1行で
# OAUTH_CLIENT_JSON='{"client_id":"...","client_secret":"..."}'
# プロファイルの暗号鍵（base64 の32バイト）は make env-login が .env にだけ PROFILE_ENCRYPTION_KEY として自動生成する。Git に含めない
